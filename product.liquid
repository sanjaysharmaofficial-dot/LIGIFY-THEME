<div class="product-specifications">
  <h4>Technical Specifications</h4>
  <table class="spec-table">
    <tr>
      <td class="spec-label">Wattage</td>
      <td>{{ product.metafields.specs.wattage }}W</td>
    </tr>
    <tr>
      <td class="spec-label">Lumens</td>
      <td>{{ product.metafields.specs.lumens }} lm</td>
    </tr>
    <tr>
      <td class="spec-label">Color Temp</td>
      <td>{{ product.metafields.specs.color_temp }}K</td>
    </tr>
    <tr>
      <td class="spec-label">Certifications</td>
      <td>UL Listed, Energy Star, RoHS</td>
    </tr>
  </table>
</div>

<div class="bulk-order-cta">
  <p>Ordering for a commercial project?</p>
  <button class="btn btn-outline-green" onclick="openQuoteForm()">Request Bulk Quote</button>
</div>
