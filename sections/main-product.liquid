<section style="padding: 60px 20px;">
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" style="width:100%; border-radius:8px;">
      </div>
      <div class="col-md-6">
        <h1 style="color: #0F5132;">{{ product.title }}</h1>
        <p style="font-size: 1.5rem; font-weight: bold;">{{ product.price | money }}</p>
        <div style="margin: 30px 0;">
          {{ product.description }}
        </div>
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" style="background: #F4C430; color: black; padding: 20px 40px; border: none; font-weight: bold; width: 100%; cursor: pointer; border-radius: 5px;">
            Add to Cart
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>
{% schema %} { "name": "Product Page", "settings": [] } {% endschema %}
