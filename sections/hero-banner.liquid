<section class="hero-banner" style="background-image: url('{{ section.settings.image | img_url: '2000x' }}');">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-content text-{{ section.settings.alignment }}">
      <span class="hero-subtitle">{{ section.settings.subtitle }}</span>
      <h1 class="hero-title">{{ section.settings.title }}</h1>
      <p class="hero-description">{{ section.settings.text }}</p>
      <div class="hero-btns">
        <a href="{{ section.settings.link }}" class="btn btn-primary-eco">{{ section.settings.btn_label }}</a>
        <a href="{{ section.settings.link_2 }}" class="btn btn-outline-white">Commercial Solutions</a>
      </div>
    </div>
  </div>
</section>
