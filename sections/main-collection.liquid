<div class="collection-container d-flex">
  <aside class="collection-sidebar pe-4" style="width: 280px;">
    <form class="filter-form">
      {%- for filter in collection.filters -%}
        <div class="filter-group mb-4 border-bottom pb-3">
          <h5 class="filter-title fw-bold small text-uppercase mb-3">{{ filter.label }}</h5>
          
          {%- case filter.type -%}
            {%- when 'list' -%}
              <ul class="filter-list list-unstyled">
                {%- for value in filter.values -%}
                  <li class="filter-item d-flex align-items-center mb-2">
                    <input type="checkbox" 
                           name="{{ value.param_name }}" 
                           value="{{ value.value }}" 
                           id="Filter-{{ filter.label }}-{{ forloop.index }}"
                           {% if value.active %}checked{% endif %}
                           {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    <label for="Filter-{{ filter.label }}-{{ forloop.index }}" class="ms-2 small {% if value.count == 0 %}text-muted{% endif %}">
                      {{ value.label }} ({{ value.count }})
                    </label>
                  </li>
                {%- endfor -%}
              </ul>

            {%- when 'price_range' -%}
              <div class="filter-price-range d-flex gap-2">
                <input name="{{ filter.min_value.param_name }}" placeholder="Min" type="number" class="form-control form-control-sm">
                <input name="{{ filter.max_value.param_name }}" placeholder="Max" type="number" class="form-control form-control-sm">
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
      
      <noscript>
        <button type="submit" class="btn btn-primary-eco btn-sm w-100">Apply Filters</button>
      </noscript>
    </form>
  </aside>

  <div class="product-grid-flex flex-grow-1">
    <div class="collection-toolbar d-flex justify-content-between align-items-center mb-4">
      <p class="mb-0">{{ collection.products_count }} Products Found</p>
      <div class="sorting-wrapper">
        <select name="sort_by" class="form-select form-select-sm" id="SortBy">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4" id="ProductGridContainer">
      {% for product in collection.products %}
        <div class="col">
          {% render 'product-card', product: product %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
